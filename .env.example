# R0/R1 never sends audio or transcripts to the network.
# Models are downloaded only by the explicit `siling-voice models download` command.
# Default: %LOCALAPPDATA%\SiLing\models on Windows; ~/.cache/SiLing/models on Linux.
# SILING_MODEL_DIR=C:\Users\YourName\AppData\Local\SiLing\models
# SILING_CONFIG_DIR=C:\Users\YourName\AppData\Local\SiLing
# No API keys are needed. .env is a template, not automatically loaded.

